{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journal Fit (aderência — não é probabilidade de aceitação)",
  "type": "object",
  "required": [
    "journal",
    "slug",
    "publisher",
    "aims_scope",
    "dimensions",
    "open_access",
    "apc",
    "indexing",
    "review_time",
    "publication_time",
    "key_requirements",
    "similar_articles",
    "risks",
    "date_verified"
  ],
  "properties": {
    "journal": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "aims_scope": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "NOT_VERIFIED"
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "topic_fit",
        "method_fit",
        "contribution_fit",
        "empirical_fit",
        "audience_fit",
        "recent_publication_fit",
        "article_type_fit"
      ],
      "properties": {
        "topic_fit": {
          "type": "object",
          "required": [
            "rating",
            "justification",
            "evidence"
          ],
          "properties": {
            "rating": {
              "type": "string",
              "enum": [
                "STRONG",
                "MODERATE",
                "WEAK",
                "INSUFFICIENT_EVIDENCE"
              ]
            },
            "justification": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "checked_on"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "doi": {
                    "type": "string",
                    "minLength": 1
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checked_on": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "note": {
                    "type": "string"
                  }
