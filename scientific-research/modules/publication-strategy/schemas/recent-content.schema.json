{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conteúdo recente do periódico",
  "type": "object",
  "required": [
    "journal",
    "window",
    "search_log",
    "articles"
  ],
  "properties": {
    "journal": {
      "type": "string",
      "minLength": 1
    },
    "issn": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "required": [
        "from_year",
        "to_year"
      ],
      "properties": {
        "from_year": {
          "type": "integer"
        },
        "to_year": {
          "type": "integer"
        }
      }
    },
    "search_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "query",
          "date",
          "returned",
          "discarded_other_journal"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "filters": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "returned": {
            "type": [
              "integer",
              "string"
            ],
            "minLength": 1
          },
          "discarded_other_journal": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "authors",
          "year",
          "doi",
          "url",
          "method",
          "relation",
          "relation_note",
          "retrieved_via"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": [
              "array",
              "string"
            ],
            "minLength": 1
          },
          "year": {
            "type": "integer"
          },
          "doi": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "same_topic_same_method",
              "same_topic_other_method",
              "same_method_other_topic",
              "same_sector_or_jurisdiction",
              "related",
              "not_comparable"
            ]
          },
          "relation_note": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_via": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "$id": "recent-content.schema.json"
}
