{
  "description": "Scientific Research: lembrete de integridade na sessão, confirmação antes de alterar dados brutos e antes de escrever em bibliotecas de referência (Zotero somente leitura por padrão).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/protect_raw_data.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/protect_raw_data.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/protect_raw_data.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_library_writes.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_library_writes.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_library_writes.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
