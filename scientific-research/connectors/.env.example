# Variáveis OPCIONAIS do plugin Scientific Research.
# Nunca coloque credenciais reais neste arquivo nem no repositório.

# E-mail de contato enviado no User-Agent para Crossref/OpenAlex ("polite pool").
# Não é credencial; deixe vazio se não quiser informar.
SR_CONTACT_EMAIL=

# Apenas se você optar pelo Zotero Web API (em vez do modo local) no MCP comunitário.
# Crie a chave em https://www.zotero.org/settings/keys com permissão SOMENTE LEITURA.
# ZOTERO_API_KEY=
# ZOTERO_LIBRARY_ID=
