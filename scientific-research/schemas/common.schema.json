{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Definições comuns — Scientific Research",
  "$defs": {
    "nr": {
      "description": "Marcador de campo ausente/não aplicável. Campos vazios ou null são inválidos.",
      "type": "string",
      "enum": ["NR — não reportado", "NA — não se aplica"]
    },
    "text_or_nr": {
      "type": "string",
      "minLength": 1
    },
    "number_or_nr": {
      "type": ["number", "string"],
      "minLength": 1
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONTRADICTED", "NOT_REPORTED"]
    },
    "source_id": {
      "type": "string",
      "pattern": "^S-[0-9]{4,}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^E-[0-9]{4,}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "location": {
      "type": "object",
      "required": ["page", "section"],
      "properties": {
        "page": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "figure": { "type": "string", "minLength": 1 },
        "appendix": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 }
      }
    }
  }
}
