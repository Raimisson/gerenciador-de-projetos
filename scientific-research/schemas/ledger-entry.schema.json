{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-entry.schema.json",
  "title": "Entrada do Evidence Ledger (uma linha de research/ledger/evidence.jsonl)",
  "type": "object",
  "required": ["evidence_id", "source_id", "citation", "doi", "url", "page", "section", "excerpt", "claim_supported", "evidence_type", "method", "design_class", "context", "quantitative_result", "verification_status", "verified_by", "verified_on"],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^E-[0-9]{4,}$" },
    "source_id": { "type": "string", "pattern": "^S-[0-9]{4,}$" },
    "citation": { "type": "string", "minLength": 1 },
    "doi": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "page": { "type": "string", "minLength": 1 },
    "table": { "type": "string", "minLength": 1 },
    "figure": { "type": "string", "minLength": 1 },
    "section": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1 },
    "claim_supported": { "type": "string", "minLength": 1 },
    "evidence_type": { "type": "string", "enum": ["source_evidence", "author_interpretation", "analytic_inference"] },
    "derived_from": { "type": "array", "items": { "type": "string", "pattern": "^E-[0-9]{4,}$" } },
    "method": { "type": "string", "minLength": 1 },
    "design_class": { "type": "string", "enum": ["causal", "associational", "descriptive", "simulation", "normative", "review", "NR — não reportado"] },
    "context": {
      "type": "object",
      "required": ["country", "population", "period", "sector"],
      "properties": {
        "country": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "sector": { "type": "string", "minLength": 1 }
      }
    },
    "quantitative_result": {
      "type": ["object", "string"],
      "minLength": 1,
      "properties": {
        "estimate": { "type": ["number", "string"], "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "se": { "type": ["number", "string"], "minLength": 1 },
        "ci_low": { "type": ["number", "string"], "minLength": 1 },
        "ci_high": { "type": ["number", "string"], "minLength": 1 },
        "p_value": { "type": ["number", "string"], "minLength": 1 },
        "n": { "type": ["number", "string"], "minLength": 1 }
      }
    },
    "verification_status": { "type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONTRADICTED", "NOT_REPORTED"] },
    "verified_by": { "type": "string", "minLength": 1 },
    "verified_on": { "type": "string", "minLength": 1 },
    "used_in": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
