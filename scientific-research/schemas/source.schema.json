{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Registro de fonte (sources.json → sources[])",
  "type": "object",
  "required": ["source_id", "source_type", "authors", "year", "title", "container", "doi", "url", "peer_reviewed", "access_level", "metadata_verification"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^S-[0-9]{4,}$" },
    "source_type": {
      "type": "string",
      "enum": ["peer_reviewed_article", "working_paper", "preprint", "official_report", "official_dataset", "regulator_document", "legislation", "technical_report", "program_evaluation", "international_org_report", "think_tank_report", "systematic_review", "book", "book_chapter", "thesis", "conference_paper", "dataset_documentation", "news", "blog", "other"]
    },
    "authors": { "type": ["array", "string"], "items": { "type": "string", "minLength": 1 }, "minItems": 1, "minLength": 1 },
    "year": { "type": ["integer", "string"], "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "container": { "type": "string", "minLength": 1, "description": "Periódico, série, editora ou instituição emissora" },
    "volume": { "type": "string", "minLength": 1 },
    "issue": { "type": "string", "minLength": 1 },
    "pages": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "doi": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "peer_reviewed": { "type": ["boolean", "string"], "enum": [true, false, "unknown"] },
    "access_level": { "type": "string", "enum": ["full_text", "abstract_only", "metadata_only", "not_accessed"] },
    "found_via": { "type": "string", "minLength": 1 },
    "metadata_verification": {
      "type": "object",
      "required": ["status", "checked_against", "checked_on"],
      "properties": {
        "status": { "type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONTRADICTED", "NOT_REPORTED"] },
        "checked_against": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "checked_on": { "type": "string", "minLength": 1 },
        "discrepancies": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "regulatory": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["LEG", "REG", "PROP", "AIR", "ARR", "CP", "NT", "DEC", "GUIDE", "EVAL", "GOV", "DATA", "ACAD", "GREY", "INTL"] },
        "jurisdiction": { "type": "string" },
        "instrument_type": { "type": "string" },
        "status": { "type": "string", "enum": ["in_force", "amended", "revoked", "proposed", "not_applicable", "unknown"] },
        "status_checked_on": { "type": "string" }
      }
    },
    "grey": {
      "type": "object",
      "properties": {
        "issuer": { "type": "string" },
        "independence": { "type": "string", "enum": ["independent", "commissioned_by_interested_party", "self_evaluation", "unknown"] },
        "version": { "type": "string" }
      }
    },
    "related_versions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
