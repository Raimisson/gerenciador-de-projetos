{
  "name": "gerenciador-de-projetos",
  "version": "1.0.0",
  "description": "Sistema full-stack de gerenciamento de projetos e tarefas (Express + better-sqlite3 + frontend puro)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist:win": "electron-builder --win",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.raimisson.gerenciador",
    "productName": "Gerenciador de Projetos",
    "files": [
      "main.js",
      "server.js",
      "db.js",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
